# Optional. Without a token /admin is available only from localhost.
VINO_ADMIN_TOKEN=replace-with-a-long-random-token

# Runtime defaults. The model cache is never downloaded from during a demo.
VINO_DEVICE=auto
VINO_LOCAL_FILES_ONLY=1
VINO_MAX_PARALLEL=1
VINO_OCR_CANDIDATE_COUNT=10
VINO_MAX_UPLOAD_BYTES=15728640
# Optional local folder exposed by the /review batch-calibration page.
VINO_REVIEW_SET_DIR=data/test/recheck_fuzzy_v2/images

# Used only when running `npm run dev` in app/frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
